# Copy to .env locally. This file contains placeholders only.
# ima credentials belong to an account with access to the designated shared KB.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# Optional local selector. Never publish the real identifier in screenshots.
IMA_KNOWLEDGE_BASE_ID=
# Absolute path to the official script after extracting the full Skill package.
IMA_SKILL_SCRIPT=
# OpenAI-compatible Chat Completions endpoint. Original ima text is sent to this provider
# only after the user clicks "生成并核验图文". Choose a provider the team is allowed to use.
# Empty values are not working defaults.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional for providers/models that support it, for example: low or medium.
LLM_REASONING_EFFORT=
