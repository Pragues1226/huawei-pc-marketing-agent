# Copy to .env locally. This file contains placeholders only.
# ima credentials belong to an account with access to the designated shared KB.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# Optional local selector. Never publish the real identifier in screenshots.
IMA_KNOWLEDGE_BASE_ID=
# Absolute path to the official script after extracting the full Skill package.
IMA_SKILL_SCRIPT=
# The team chose DeepSeek V4.1 Flash; API key must be added locally.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# DeepSeek supports JSON mode and reasoning_effort=none.
LLM_JSON_MODE=true
LLM_REASONING_EFFORT=none
# ima (default) or local (explicit user-provided archive fallback).
KNOWLEDGE_SOURCE=ima
LOCAL_KNOWLEDGE_ZIP=
