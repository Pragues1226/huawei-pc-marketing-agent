      "css": ".ds-portal-enter{display:inline-flex;align-items:center;justify-content:center;gap:32px;min-height:52px;padding:17px 25px;border:0;border-radius:99px;background:#fdf1e1;color:#173b3c;font:14px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;box-shadow:0 10px 40px #092e3533;cursor:pointer;transition:background .2s,box-shadow .2s}.ds-portal-enter:hover{background:#fff5df;color:#143a3b}.ds-portal-enter:focus-visible{outline:3px solid #fff5df;outline-offset:5px}.ds-portal-enter:active{transform:translateY(1px)}"
