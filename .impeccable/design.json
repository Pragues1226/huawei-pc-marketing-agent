      "html": "<label class=\"ds-label\" for=\"ds-product\">产品型号</label><input class=\"ds-field\" id=\"ds-product\" placeholder=\"填写具体型号、系统与销售版本\">",
      "css": ".ds-label{display:block;margin:18px 0 9px;color:var(--ink,#1e3538);font:600 12px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif}.ds-field{width:100%;min-height:42px;padding:12px 13px;border:1px solid #dfe5dd;border-radius:7px;background:var(--paper,#fffefa);color:var(--ink,#1e3538);font:13px Inter,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;outline:none;transition:border-color .2s,box-shadow .2s}.ds-field::placeholder{color:#647469;opacity:1}.ds-field:focus,.ds-field:focus-visible{border-color:#72a791;box-shadow:0 0 0 3px #14795f0c}"
