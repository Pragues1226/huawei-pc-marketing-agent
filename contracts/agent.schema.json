{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huawei-pc-marketing-agent:contract:v1",
  "title": "团队接口约定 v1",
  "description": "跨语言数据约定；具体函数或 HTTP 路由由团队确定。校验 task/retrieval/result 时引用对应 $defs。",
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "product", "audience", "scenario", "platform", "goal"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "product": {"type": "string"},
        "audience": {"type": "string"},
        "scenario": {"type": "string"},
        "platform": {"enum": ["xiaohongshu", "wechat_article", "wechat_moments"]},
        "goal": {"type": "string"},
        "purchase_stage": {"type": "string"},
        "revision": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "retrieved_at"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "product", "statement", "source_ids"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "quote"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "quote": {"type": "string", "minLength": 4}
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_id", "product", "name", "source_id", "asset_ref", "caption"],
      "properties": {
        "image_id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "asset_ref": {"type": "string", "minLength": 1},
        "caption": {"type": "string"}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "status", "sources", "facts", "images", "warnings"],
      "properties": {
        "request_id": {"type": "string"},
        "status": {"enum": ["ok", "partial", "empty", "error"]},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "images": {"type": "array", "items": {"$ref": "#/$defs/image"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "status", "questions", "scenario_analysis", "strategy", "evidence", "article", "verification"],
      "properties": {
        "request_id": {"type": "string"},
        "status": {"enum": ["needs_input", "blocked", "ready", "error"]},
        "questions": {"type": "array", "items": {"type": "string"}},
        "scenario_analysis": {"type": "string"},
        "strategy": {"type": "string"},
        "evidence": {"$ref": "#/$defs/retrieval"},
        "article": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/article"}]},
        "verification": {"type": "array", "items": {"$ref": "#/$defs/check"}}
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "lead", "body", "cta", "tags", "image_plan", "used_fact_ids"],
      "properties": {
        "title": {"type": "string"},
        "lead": {"type": "string"},
        "body": {"type": "string"},
        "cta": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "used_fact_ids": {"type": "array", "items": {"type": "string"}},
        "image_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image_id", "position", "caption", "reason"],
            "properties": {
              "image_id": {"type": "string"},
              "position": {"type": "string"},
              "caption": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "status", "detail", "evidence_ids"],
      "properties": {
        "category": {"enum": ["fact", "image", "compliance", "platform"]},
        "status": {"enum": ["pass", "fail", "pending"]},
        "detail": {"type": "string"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
